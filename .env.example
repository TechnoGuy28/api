# Exemplo de variaveis de ambiente da API.
# Copie para '.env' e preencha com os valores reais.
# Esta API e um projeto INDEPENDENTE: roda em servidor proprio e so ela acessa o banco.

# String de conexao com o PostgreSQL hospedado no Neon.
# Exemplo: postgresql://usuario:senha@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_WjVN1kbI9Zag@ep-tiny-waterfall-ayg1no0b-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Segredo para assinatura dos JWTs. Use um valor longo e aleatorio em producao.
JWT_SECRET=change-me-to-a-long-random-secret

# Tempo de expiracao do token (ex.: 2h, 7d, 86400s)
JWT_EXPIRES_IN=2h

# Porta em que a API escuta
PORT=3000

# Origem do frontend PHP autorizada a chamar a API (CORS).
# Em producao, defina a URL real do servidor do PHP.
CORS_ORIGIN=http://localhost

# Ativa logs detalhados (true/false)
DEBUG=false
